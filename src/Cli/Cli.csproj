<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- За замовчуванням net10.0; для демонстрації multi-targeting: -p:CliTfm=net8.0 -->
    <CliTfm Condition="'$(CliTfm)' == ''">net10.0</CliTfm>
    <TargetFramework>$(CliTfm)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
